<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BTS ARMY - Tribute Page</title>
    <!-- Link to the external CSS file -->
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <header>
        <h1>BORAHAE ARMY 💜</h1>
        <p class="tagline">Official/Fan Tribute Page for BTS & ARMY</p>
    </header>

    <main class="container">
        <section class="card">
            <h2>About ARMY</h2>
            <p><strong>ARMY</strong> stands for <em>Adorable Representative M.C. for Youth</em>. Formed on July 9, 2013, it represents the dedicated global fanbase supporting BTS.</p>
        </section>

        <section class="card">
            <h2>The 7 Members</h2>
            <ul class="member-list">
                <li><strong>RM</strong> (Kim Namjoon) - Leader, Rapper</li>
                <li><strong>Jin</strong> (Kim Seokjin) - Vocalist</li>
                <li><strong>SUGA</strong> (Min Yoongi) - Rapper, Producer</li>
                <li><strong>j-hope</strong> (Jung Hoseok) - Rapper, Dancer</li>
                <li><strong>Jimin</strong> (Park Jimin) - Vocalist, Dancer</li>
                <li><strong>V</strong> (Kim Taehyung) - Vocalist, Dancer</li>
                <li><strong>Jung Kook</strong> (Jeon Jungkook) - Main Vocalist, Dancer</li>
            </ul>
        </section>

        <!-- Interactive Fan Button -->
        <section class="interaction-zone">
            <button id="heartBtn">Send a Purple Heart to BTS</button>
            <div id="heartCounter">Hearts Sent: <span id="count">0</span></div>
        </section>
    </main>

    <footer>
        <p>I purple you 💜 We are not seven with you.</p>
    </footer>

    <!-- Link to the external JavaScript file -->
    <script src="script.js"></script>
</body>
</html>
/* Base Page Styling */
body {
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', Arial, sans-serif;
    background-color: #0b0b0e;
    color: #ffffff;
    text-align: center;
}

/* Header Banner */
header {
    background: linear-gradient(135deg, #1e0533, #38135c);
    padding: 60px 20px;
    border-bottom: 3px solid #9c27b0;
}

h1 {
    font-size: 3rem;
    color: #d1c4e9;
    margin: 0;
    letter-spacing: 2px;
}

.tagline {
    font-size: 1.2rem;
    color: #b39ddb;
    margin-top: 10px;
}

/* Content Container */
.container {
    max-width: 800px;
    margin: 40px auto;
    padding: 0 20px;
}

/* Informational Cards */
.card {
    background-color: #171520;
    border: 1px solid #4a148c;
    border-radius: 12px;
    padding: 25px;
    margin-bottom: 25px;
    box-shadow: 0 4px 15px rgba(156, 39, 176, 0.2);
    text-align: left;
}

.card h2 {
    color: #e1bee7;
    margin-top: 0;
    border-bottom: 1px solid #38135c;
    padding-bottom: 8px;
}

.member-list {
    padding-left: 20px;
}

.member-list li {
    margin-bottom: 10px;
    color: #d1c4e9;
    font-size: 1.1rem;
}

/* Interactive Button Styling */
.interaction-zone {
    margin-top: 30px;
    padding: 20px;
}

#heartBtn {
    background-color: #9c27b0;
    color: white;
    border: none;
    padding: 15px 30px;
    font-size: 1.1rem;
    font-weight: bold;
    border-radius: 30px;
    cursor: pointer;
    transition: transform 0.2s, background-color 0.2s;
    box-shadow: 0 0 15px rgba(156, 39, 176, 0.5);
}

#heartBtn:hover {
    background-color: #ba68c8;
    transform: scale(1.05);
}

#heartBtn:active {
    transform: scale(0.95);
}

#heartCounter {
    margin-top: 15px;
    font-size: 1.2rem;
    color: #b39ddb;
}

/* Footer */
footer {
    margin-top: 60px;
    padding: 25px;
    background-color: #08060a;
    color: #7e57c2;
    font-size: 0.9rem;
}
// Wait for the DOM to completely load
document.addEventListener('DOMContentLoaded', () => {
    let heartCount = 0;
    const heartBtn = document.getElementById('heartBtn');
    const countDisplay = document.getElementById('count');

    // Add click event listener to the button
    heartBtn.addEventListener('click', () => {
        heartCount++;
        countDisplay.textContent = heartCount;
        
        // Console log for debugging inside VS Code environment
        console.log(`Total purple hearts sent: ${heartCount}`);
    });
});